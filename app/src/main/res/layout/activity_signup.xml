<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <!-- Back arrow style header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:background="@drawable/bg_assign_banner"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:letterSpacing="0.1"
                android:text="CREATE ACCOUNT"
                android:textColor="#7A95B8"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Join Healyn"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Start your recovery journey today"
                android:textColor="#7A95B8"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Full Name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Full Name"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#1A2E4A"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Enter your full name"
            android:textColor="#1A2E4A"
            android:textColorHint="#9CA3AF"
            android:padding="14dp"
            android:background="@drawable/input_bg"
            android:layout_marginBottom="16dp"/>

        <!-- Email -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#1A2E4A"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Enter your email"
            android:textColor="#1A2E4A"
            android:textColorHint="#9CA3AF"
            android:inputType="textEmailAddress"
            android:padding="14dp"
            android:background="@drawable/input_bg"
            android:layout_marginBottom="16dp"/>

        <!-- Phone -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone Number"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#1A2E4A"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Enter your phone number"
            android:textColor="#1A2E4A"
            android:textColorHint="#9CA3AF"
            android:inputType="phone"
            android:padding="14dp"
            android:background="@drawable/input_bg"
            android:layout_marginBottom="16dp"/>

        <!-- Password -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#1A2E4A"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Minimum 6 characters"
            android:textColor="#1A2E4A"
            android:textColorHint="#9CA3AF"
            android:inputType="textPassword"
            android:padding="14dp"
            android:background="@drawable/input_bg"
            android:layout_marginBottom="24dp"/>

        <!-- Role -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I am a"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#1A2E4A"
            android:layout_marginBottom="12dp"/>

        <RadioGroup
            android:id="@+id/rgRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="32dp">

            <RadioButton
                android:id="@+id/rbPatient"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Patient"
                android:textColor="#1A2E4A"
                android:textSize="14sp"
                android:checked="true"
                android:buttonTint="#028090"
                android:gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:background="@drawable/input_bg"
                android:paddingStart="12dp"/>

            <RadioButton
                android:id="@+id/rbPhysio"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Physiotherapist"
                android:textColor="#1A2E4A"
                android:textSize="14sp"
                android:buttonTint="#028090"
                android:gravity="center_vertical"
                android:background="@drawable/input_bg"
                android:paddingStart="12dp"/>
        </RadioGroup>

        <!-- Signup Button -->
        <Button
            android:id="@+id/btnSignup"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Create Account"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1A2E4A"
            android:stateListAnimator="@null"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/tvLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already have an account? Log In"
            android:textColor="#028090"
            android:textSize="13sp"
            android:layout_marginBottom="40dp"/>

    </LinearLayout>
</ScrollView>