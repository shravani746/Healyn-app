<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6FCFF"
    tools:context=".SplashActivity">

    <!-- Top Soft Circle -->
    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-60dp"
        android:background="#DFF6F8" />

    <!-- Bottom Soft Circle -->
    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginBottom="-60dp"
        android:layout_marginStart="-40dp"
        android:background="#CDEFF3" />

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="30dp">

        <!-- Logo Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="32dp"
            app:cardElevation="10dp"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:cardBackgroundColor="#FFFFFF">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp"
                android:src="@drawable/healyn_logo"
                android:scaleType="fitCenter" />

        </androidx.cardview.widget.CardView>

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Physiotherapy Monitoring"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#4B5563"
            android:letterSpacing="0.03"
            android:layout_marginBottom="45dp" />

        <!-- Login Button -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="280dp"
            android:layout_height="55dp"
            android:text="LOGIN"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#028090"
            android:layout_marginBottom="18dp" />

        <!-- Signup Button -->
        <Button
            android:id="@+id/btnSignup"
            android:layout_width="280dp"
            android:layout_height="55dp"
            android:text="Sign Up"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="#028090"
            android:backgroundTint="#DFF6F8" />

    </LinearLayout>

</RelativeLayout>