<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FBFB">

    <!-- Top Right Circle -->

    <View
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="-120dp"
        android:layout_marginEnd="-120dp"
        android:background="@drawable/top_circle"/>

    <!-- Bottom Left Circle -->

    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="-130dp"
        android:layout_marginStart="-130dp"
        android:background="@drawable/bottom_circle"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="344dp"
        android:layout_centerInParent="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="226dp"
            android:layout_height="142dp"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/healyn_logo" />

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="95dp"
            android:layout_marginTop="0dp"
            android:fontFamily="@font/great_vibes"
            android:text="Healyn"
            android:textColor="#00897B"
            android:textSize="62sp" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="195dp"
            android:layout_height="25dp"
            android:layout_marginTop="20dp"
            app:srcCompat="@drawable/img" />

        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:letterSpacing="0.08"
            android:text="Heal. Move. Thrive."
            android:textColor="#2D8A8A"
            android:textSize="18sp" />

    </LinearLayout>

</RelativeLayout>