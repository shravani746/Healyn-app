<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F5FC">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0F1E35"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="13dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:gravity="center"
                android:background="@drawable/bg_back_btn"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR JOURNEY"
                    android:textColor="#73FFFFFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.04"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Progress"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Stat strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="6dp"
                android:orientation="vertical" android:background="@drawable/bg_stat_pill"
                android:padding="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="78%" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="RECOVERY" android:textColor="#73FFFFFF" android:textSize="9sp" android:letterSpacing="0.04"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="6dp"
                android:orientation="vertical" android:background="@drawable/bg_stat_pill"
                android:padding="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="12" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="SESSIONS" android:textColor="#73FFFFFF" android:textSize="9sp" android:letterSpacing="0.04"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical" android:background="@drawable/bg_stat_pill"
                android:padding="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="5" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="STREAK" android:textColor="#73FFFFFF" android:textSize="9sp" android:letterSpacing="0.04"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- SCROLLABLE BODY -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Recovery ring card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_mini_card"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <!-- Ring placeholder (custom view) -->
                <com.example.physioapp.ProgressRingView
                    android:id="@+id/progressRing"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="14dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recovery Score"
                        android:textColor="#0F1E35"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Week 2 of rehabilitation"
                        android:textColor="#5A6A80"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↑ +6% from last week"
                        android:textColor="#2BAE7E"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="3dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Mini stat cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="8dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_mini_card"
                    android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="85%" android:textColor="#0F1E35" android:textSize="20sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="AVG ACCURACY" android:textColor="#5A6A80" android:textSize="9sp" android:layout_marginTop="3dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="↑ +3% this week" android:textColor="#2BAE7E" android:textSize="9sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_mini_card"
                    android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="10" android:textColor="#0F1E35" android:textSize="20sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="TOTAL SESSIONS" android:textColor="#5A6A80" android:textSize="9sp" android:layout_marginTop="3dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="↑ 3 new this week" android:textColor="#2BAE7E" android:textSize="9sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Weekly chart -->
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="WEEKLY ACTIVITY"
                android:textColor="#9AAABB" android:textSize="10sp"
                android:textStyle="bold" android:letterSpacing="0.08"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_chart_card"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <!-- Mon -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal">
                        <View android:layout_width="match_parent" android:layout_height="28dp" android:background="#E3E9F4"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mon" android:textColor="#9AAABB" android:textSize="9sp" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                    <!-- Tue -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal" android:layout_marginStart="6dp">
                        <View android:layout_width="match_parent" android:layout_height="56dp" android:background="#4A90E2"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tue" android:textColor="#9AAABB" android:textSize="9sp" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                    <!-- Wed -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal" android:layout_marginStart="6dp">
                        <View android:layout_width="match_parent" android:layout_height="40dp" android:background="#4A90E2"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wed" android:textColor="#9AAABB" android:textSize="9sp" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                    <!-- Thu -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal" android:layout_marginStart="6dp">
                        <View android:layout_width="match_parent" android:layout_height="20dp" android:background="#E3E9F4"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thu" android:textColor="#9AAABB" android:textSize="9sp" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                    <!-- Fri -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal" android:layout_marginStart="6dp">
                        <View android:layout_width="match_parent" android:layout_height="64dp" android:background="#2BAE7E"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fri" android:textColor="#9AAABB" android:textSize="9sp" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                    <!-- Sat -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal" android:layout_marginStart="6dp">
                        <View android:layout_width="match_parent" android:layout_height="50dp" android:background="#2BAE7E"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sat" android:textColor="#9AAABB" android:textSize="9sp" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                    <!-- Sun -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal" android:layout_marginStart="6dp">
                        <View android:layout_width="match_parent" android:layout_height="12dp" android:background="#E3E9F4"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sun" android:textColor="#9AAABB" android:textSize="9sp" android:layout_marginTop="4dp"/>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- Recent Sessions label -->
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="RECENT SESSIONS"
                android:textColor="#9AAABB" android:textSize="10sp"
                android:textStyle="bold" android:letterSpacing="0.08"
                android:layout_marginBottom="10dp"/>

            <!-- Session item 1 -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/bg_sess_item"
                android:padding="11dp" android:layout_marginBottom="8dp">
                <TextView android:layout_width="36dp" android:layout_height="36dp"
                    android:text="SR" android:textColor="#2BAE7E" android:textSize="11sp" android:textStyle="bold"
                    android:gravity="center" android:background="@drawable/bg_sess_icon_green"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Shoulder Rotation" android:textColor="#0F1E35" android:textSize="12sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Today · 3 sets · 10 reps" android:textColor="#5A6A80" android:textSize="10sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Done" android:textColor="#0a6645" android:textSize="10sp" android:textStyle="bold"
                    android:background="@drawable/bg_badge_green" android:paddingHorizontal="9dp" android:paddingVertical="3dp"/>
            </LinearLayout>

            <!-- Session item 2 -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/bg_sess_item"
                android:padding="11dp" android:layout_marginBottom="8dp">
                <TextView android:layout_width="36dp" android:layout_height="36dp"
                    android:text="KE" android:textColor="#4A90E2" android:textSize="11sp" android:textStyle="bold"
                    android:gravity="center" android:background="@drawable/bg_sess_icon_blue"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Knee Extension" android:textColor="#0F1E35" android:textSize="12sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Yesterday · 3 sets" android:textColor="#5A6A80" android:textSize="10sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="92%" android:textColor="#0c447c" android:textSize="10sp" android:textStyle="bold"
                    android:background="@drawable/bg_badge_blue" android:paddingHorizontal="9dp" android:paddingVertical="3dp"/>
            </LinearLayout>

            <!-- Session item 3 -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/bg_sess_item"
                android:padding="11dp" android:layout_marginBottom="16dp">
                <TextView android:layout_width="36dp" android:layout_height="36dp"
                    android:text="HF" android:textColor="#2BAE7E" android:textSize="11sp" android:textStyle="bold"
                    android:gravity="center" android:background="@drawable/bg_sess_icon_green"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Hip Flexor Stretch" android:textColor="#0F1E35" android:textSize="12sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="2 days ago · 2 sets" android:textColor="#5A6A80" android:textSize="10sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Done" android:textColor="#0a6645" android:textSize="10sp" android:textStyle="bold"
                    android:background="@drawable/bg_badge_green" android:paddingHorizontal="9dp" android:paddingVertical="3dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnBackToDashboard"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="← Back to Dashboard"
                android:backgroundTint="#1A2E4A"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAV -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_nav"
        android:paddingTop="9dp"
        android:paddingBottom="14dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <View android:layout_width="20dp" android:layout_height="3dp" android:background="#00000000"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏠" android:textSize="19sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home" android:textColor="#BBCCE0" android:textSize="9sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <View android:layout_width="20dp" android:layout_height="3dp" android:background="#00000000"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏃" android:textSize="19sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Exercise" android:textColor="#BBCCE0" android:textSize="9sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <View android:layout_width="20dp" android:layout_height="3dp" android:background="#4A90E2"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📈" android:textSize="19sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Progress" android:textColor="#4A90E2" android:textSize="9sp" android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>