<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#122237">

    <!-- Decorative circle top-right -->
    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-80dp"
        android:background="@drawable/bg_header_circle1" />

    <!-- Decorative circle bottom-left -->
    <View
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="-60dp"
        android:layout_marginBottom="-60dp"
        android:background="@drawable/bg_header_circle2" />

    <!-- Center content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="310dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <!-- Logo -->

        <!-- App name -->

        <!-- Divider line -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="186dp"
            android:layout_height="120dp"
            android:layout_marginBottom="8dp"
            android:scaleType="fitCenter"
            android:visibility="invisible"
            android:src="@drawable/healyn_logo" />

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/great_vibes"
            android:letterSpacing="0.04"
            android:text="Healyn"
            android:visibility="invisible"
            android:textColor="@color/white"
            android:textSize="60sp" />

        <View
            android:layout_width="48dp"
            android:layout_height="2dp"
            android:layout_marginBottom="16dp"
            android:background="#3DFFFFFF" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily=""
            android:visibility="invisible"
            android:letterSpacing="0.1"
            android:text="Heal. Move. Thrive."
            android:textColor="#C5FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Bottom version label -->

</FrameLayout>