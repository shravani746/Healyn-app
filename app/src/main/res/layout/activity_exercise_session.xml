<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F5FC">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0F1E35"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="18dp">

        <!-- Back + Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="13dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:gravity="center"
                android:background="@drawable/bg_back_btn"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOW PERFORMING"
                    android:textColor="#73FFFFFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.04"/>

                <TextView
                    android:id="@+id/tvExerciseName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shoulder Rotation"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Stat strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:background="@drawable/bg_stat_pill"
                android:padding="8dp">
                <TextView
                    android:id="@+id/tvTotalSets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SETS"
                    android:textColor="#73FFFFFF"
                    android:textSize="9sp"
                    android:letterSpacing="0.04"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:background="@drawable/bg_stat_pill"
                android:padding="8dp">
                <TextView
                    android:id="@+id/tvTotalReps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REPS"
                    android:textColor="#73FFFFFF"
                    android:textSize="9sp"
                    android:letterSpacing="0.04"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_stat_pill"
                android:padding="8dp">
                <TextView
                    android:id="@+id/tvSetsDone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DONE"
                    android:textColor="#73FFFFFF"
                    android:textSize="9sp"
                    android:letterSpacing="0.04"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- SCROLLABLE BODY -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F2F5FC">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Camera box -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/bg_camera"
                android:layout_marginBottom="13dp">

                <androidx.camera.view.PreviewView
                    android:id="@+id/previewView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

                <!-- Feedback badge overlaid at bottom center -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_feedback_badge"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="14dp">

                    <View
                        android:id="@+id/feedbackDot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/circle_white"
                        android:layout_marginEnd="5dp"/>

                    <TextView
                        android:id="@+id/tvFeedback"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Good Posture!"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.03"/>
                </LinearLayout>

            </FrameLayout>

            <!-- Set Tracker card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_set_tracker"
                android:padding="13dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CURRENT SET"
                        android:textColor="#9AAABB"
                        android:textSize="10sp"
                        android:letterSpacing="0.07"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvSetCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 / 3"
                        android:textColor="#0F1E35"
                        android:textSize="28sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <!-- Dot indicators -->
                    <LinearLayout
                        android:id="@+id/setDots"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <View
                            android:id="@+id/dot1"
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/dot_active"/>

                        <View
                            android:id="@+id/dot2"
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/dot_todo"/>

                        <View
                            android:id="@+id/dot3"
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:background="@drawable/dot_todo"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Smooth, controlled movement"
                        android:textColor="#5A6A80"
                        android:textSize="10sp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Feedback strip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_feedback_strip"
                android:padding="10dp"
                android:layout_marginBottom="13dp">

                <LinearLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:background="@drawable/bg_fb_icon_green"
                    android:layout_marginEnd="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textColor="#2BAE7E"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvFeedbackStrip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Keep your back straight"
                        android:textColor="#0F1E35"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Raise arm to shoulder height"
                        android:textColor="#5A6A80"
                        android:textSize="10sp"
                        android:layout_marginTop="1dp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Complete Set button -->
            <Button
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Complete Set ✓"
                android:backgroundTint="#2BAE7E"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <!-- End Session button -->
            <Button
                android:id="@+id/btnStop"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="End Session"
                android:backgroundTint="#1A2E4A"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAV -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_nav"
        android:paddingTop="9dp"
        android:paddingBottom="14dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <View android:layout_width="20dp" android:layout_height="3dp" android:background="#00000000"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏠" android:textSize="19sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home" android:textColor="#BBCCE0" android:textSize="9sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <View android:layout_width="20dp" android:layout_height="3dp" android:background="#4A90E2"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏃" android:textSize="19sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Exercise" android:textColor="#4A90E2" android:textSize="9sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <View android:layout_width="20dp" android:layout_height="3dp" android:background="#00000000"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📈" android:textSize="19sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Progress" android:textColor="#BBCCE0" android:textSize="9sp" android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>